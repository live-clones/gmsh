FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    "(inlet|farfield|outer).*"
    {
        type        fixedValue;
        value       uniform 300;
    }

    "outlet.*"
    {
        type        inletOutlet;
        inletValue  uniform 300;
        value       uniform 300;
    }

    "(wall|body|airfoil|blade).*"
    {
        type        zeroGradient;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
