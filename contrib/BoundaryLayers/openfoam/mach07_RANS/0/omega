FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 2.712;

boundaryField
{
    "(inlet|farfield|outer).*"
    {
        type        fixedValue;
        value       uniform 2.712;
    }

    "outlet.*"
    {
        type        inletOutlet;
        inletValue  uniform 2.712;
        value       uniform 2.712;
    }

    "(wall|body|airfoil|blade).*"
    {
        type        omegaWallFunction;
        value       uniform 2.712;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
