FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.214675;

boundaryField
{
    "(inlet|farfield|outer).*"
    {
        type        fixedValue;
        value       uniform 2.214675;
    }

    "outlet.*"
    {
        type        inletOutlet;
        inletValue  uniform 2.214675;
        value       uniform 2.214675;
    }

    "(wall|body|airfoil|blade).*"
    {
        type        kqRWallFunction;
        value       uniform 2.214675;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
