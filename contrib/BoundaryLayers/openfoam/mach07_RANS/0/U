FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (243 0 0);

boundaryField
{
    "(inlet|farfield|outer).*"
    {
        type        fixedValue;
        value       uniform (243 0 0);
    }

    "outlet.*"
    {
        type        inletOutlet;
        inletValue  uniform (243 0 0);
        value       uniform (243 0 0);
    }

    "(wall|body|airfoil|blade).*"
    {
        type        noSlip;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
