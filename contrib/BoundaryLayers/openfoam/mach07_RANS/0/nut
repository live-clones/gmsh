FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    "(inlet|outlet|farfield|outer).*"
    {
        type        calculated;
        value       uniform 1e-5;
    }

    "(wall|body|airfoil|blade).*"
    {
        type        nutkWallFunction;
        value       uniform 0;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
