FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    "(inlet|farfield|outer).*"
    {
        type        fixedValue;
        value       uniform 101325;
    }

    "outlet.*"
    {
        type        fixedValue;
        value       uniform 101325;
    }

    "(wall|body|airfoil|blade).*"
    {
        type        zeroGradient;
    }

    "(front|back|frontAndBack).*"
    {
        type        empty;
    }
}
