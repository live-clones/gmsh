FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     rhoSimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         500;

deltaT          1;

writeControl    timeStep;
writeInterval   100;

purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

functions
{
    residuals
    {
        type        residuals;
        libs        ("libutilityFunctionObjects.so");
        writeControl timeStep;
        writeInterval 10;
        fields      (p U T k omega);
    }

    yPlus
    {
        type        yPlus;
        libs        ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 50;
    }
}
