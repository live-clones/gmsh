// The words the editors color (see ScriptStyles.cpp) besides those Gmsh
// gives as it runs (the names of its options, plugins and fields): this file,
// ScriptWords.h.in, is the template of ScriptWords.h, which CMake writes in
// the build directory.

// clang-format off

// the words the lexer of the .geo language (src/parser/Gmsh.l) knows, put
// here by CMake
static const char *geoWords[] = {@GEO_WORDS@};

